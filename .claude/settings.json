{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-push-to-protected.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(node -e 'let d=\"\";process.stdin.on(\"data\",c=>d+=c).on(\"end\",()=>process.stdout.write(JSON.parse(d).tool_input?.file_path??\"\"))') && { [ -z \"$file\" ] || npx prettier --write --ignore-unknown -- \"$file\"; }",
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ]
  }
}
